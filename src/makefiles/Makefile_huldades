TFLAGS = -lgtest -lgtest_main
CFLAGS = -Wall -Wextra -Werror
CPP = tests/tests.cpp tests/test_set.cpp tests/test_multiset.cpp 
GFLAGS = -fprofile-arcs -ftest-coverage

all:
	@clear
	@g++ -Wall -Wextra -Werror s21_set/main.cpp
	@-./a.out
	@rm a.out

test:
	@clear
	@g++ -Wall -Wextra -Werror $(CPP) $(TFLAGS)
	@-./a.out
	@rm a.out

gcov_report: clean clear
	@g++ $(CFLAGS) $(GFLAGS) -o gcov_r $(CPP) $(TFLAGS)
	@mkdir coverage_report
	@./gcov_r
	@python3 -m gcovr -r . --html --html-details -o coverage_report/index.html --exclude test
	@rm -f *.gcno *.gcda

clean:
	@-rm -rf *.a *.o *.gc* *.out gcov_r coverage_report test.out

clear:
	@clear